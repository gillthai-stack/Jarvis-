# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Your name, so Jarvis knows who it's talking to
JARVIS_USER_NAME=Gill

# Default brain and effort (can be changed in the dashboard). low is quickest for everyday requests.
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low
# 1 = Opus fast mode: replies written up to about 2.5x faster, at twice the price per token
JARVIS_FAST=0

# Folders Jarvis may search and read, comma separated
JARVIS_SEARCH_DIRS=~/Documents,~/Desktop,~/Downloads

# Obsidian vault. Leave empty to use the vault Obsidian has open.
JARVIS_OBSIDIAN_VAULT=

# Markdown notes for the 3D knowledge graph. Leave empty to use the Obsidian vault (or ~/Documents).
JARVIS_NOTES_DIR=

# Google OAuth client file for Gmail and Calendar (see docs/google-setup.md)
# JARVIS_GOOGLE_CREDENTIALS=~/jarvis/data/google_credentials.json

JARVIS_PORT=8765

# Computer use: the only folder whose files Jarvis may move (with your approval each time)
# JARVIS_SANDBOX_DIR=~/JARVIS-Sandbox
# Port for the local desktop-control service (screenshots, clicks, typing). Listens on 127.0.0.1 only.
# JARVIS_DESKTOP_PORT=8766

# Local voice for the holographic interface. Defaults are what ./scripts/install_whisper.sh builds.
# JARVIS_WHISPER_BIN=~/jarvis/vendor/whisper.cpp/build/bin/whisper-cli
# JARVIS_WHISPER_MODEL=~/jarvis/vendor/whisper.cpp/models/ggml-base.en.bin
# JARVIS_WHISPER_THREADS=4
# Spoken replies: "say" (built into macOS) or "piper" (install separately and set the PIPER paths)
# JARVIS_TTS=say
# A voice from `say -v '?'` (empty = your Mac's system voice) and words per minute
# JARVIS_SAY_VOICE=Daniel
# JARVIS_SAY_RATE=185
# JARVIS_PIPER_BIN=
# JARVIS_PIPER_MODEL=
