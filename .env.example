# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Your name, so Jarvis knows who it's talking to
JARVIS_USER_NAME=Gill

# Default brain and effort (can be changed in the dashboard)
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=medium

# Folders Jarvis may search and read, comma separated
JARVIS_SEARCH_DIRS=~/Documents,~/Desktop,~/Downloads

JARVIS_PORT=8765
